# 이 파일을 .env 로 복사한 뒤, 쓰는 회사의 키만 붙여넣으세요. .env 는 절대 커밋하지 않습니다.
# 어느 회사를 쓸지는 config.yaml 의 provider 로 정합니다.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 공시 대조용 (무료). https://opendart.fss.or.kr 에서 발급
DART_API_KEY=

# 시장 데이터 대조용 (무료). https://openapi.krx.co.kr 에서 발급 후 '일별매매정보' API 이용 신청
KRX_API_KEY=

# 거시 통계 대조용 (무료). https://ecos.bok.or.kr/api 에서 발급
ECOS_API_KEY=

# 산업 통계 대조용 (무료). https://kosis.kr/openapi 에서 발급
KOSIS_API_KEY=
