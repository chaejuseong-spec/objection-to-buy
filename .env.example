# 이 파일을 .env 로 복사한 뒤, 쓰는 회사의 키만 붙여넣으세요. .env 는 절대 커밋하지 않습니다.
# 어느 회사를 쓸지는 config.yaml 의 provider 로 정합니다.
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

# 공시 대조용 (무료). https://opendart.fss.or.kr 에서 발급
DART_API_KEY=

# 시장 데이터 대조용 (무료). https://openapi.krx.co.kr 에서 발급 후 '일별매매정보' API 이용 신청
KRX_API_KEY=

# 거시 통계 대조용 (무료). https://ecos.bok.or.kr/api 에서 발급
ECOS_API_KEY=

# 산업 통계 대조용 (무료). https://kosis.kr/openapi 에서 발급
KOSIS_API_KEY=

# 금융회사 업권 지표 (무료). https://fisis.fss.or.kr 에서 발급
FISIS_API_KEY=

# 공공데이터포털 금융위원회_주식시세정보 (주가 차트 과거 기록, 일반 인증키 Decoding)
DATA_GO_KR_KEY=

# 토스증권 Open API (일별 주가·수급·섹터·현재가, 조회 전용. 없으면 주가는 KRX 자료로 대신)
# 토스증권 개발자 센터에서 발급하고, API를 부를 컴퓨터의 공인 IP를 허용 목록에 등록해야 합니다.
TOSS_CLIENT_ID=
TOSS_CLIENT_SECRET=
